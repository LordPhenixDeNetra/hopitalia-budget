---
// Capture d'écran de la documentation (frontend/e2e-captures/), dans la langue de la page : la capture
// anglaise si elle existe, sinon la française. Servie en WebP par Astro ; un nom inconnu fait échouer
// la construction.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  nom: string;
  alt: string;
}

const { nom, alt } = Astro.props;
const images = import.meta.glob<ImageMetadata>("../assets/captures/*/*.png", { eager: true, import: "default" });
const anglaise = Astro.locals.starlightRoute.entryMeta.lang === "en";
const src = (anglaise && images[`../assets/captures/en/${nom}.png`]) || images[`../assets/captures/fr/${nom}.png`];
if (!src) throw new Error(`Capture inconnue « ${nom} » : voir frontend/e2e-captures/captures.spec.ts`);
---

<figure class="capture">
  <Image src={src} alt={alt} format="webp" />
</figure>

<style>
  .capture img {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
</style>
