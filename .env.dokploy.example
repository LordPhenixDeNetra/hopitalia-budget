# Démonstration en ligne sur Dokploy (docker-compose.dokploy.yml ; documentation : installer/dokploy).
# Recopier dans l'onglet « Environment » de l'application Dokploy et renseigner les valeurs vides.
# Les secrets ne vont jamais dans le dépôt. Générer chacun avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Base de données
POSTGRES_USER=hopitalia
POSTGRES_PASSWORD=
POSTGRES_DB=hopitalia_budget

# Clé de chiffrement des coordonnées bancaires (Fernet) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COORDONNEES_CLE=

# Hopitalia simulé. La clé signe les jetons de connexion : longue et secrète (pas celle des tests).
# Le mot de passe est celui de tous les comptes de démonstration (agent001 à agent015, svc-budget).
HOPITALIA_JWT_CLE=
SIMULATION_MOT_DE_PASSE=
HOPITALIA_API_URL=http://hopitalia-simule:8090
HOPITALIA_COMPTE_TECHNIQUE=svc-budget
# Même valeur que SIMULATION_MOT_DE_PASSE.
HOPITALIA_COMPTE_TECHNIQUE_MOT_DE_PASSE=
HOPITALIA_ETABLISSEMENT=CHU-A
# La démonstration lance elle-même chaque échange : pas de tâche quotidienne.
INTEGRATIONS_QUOTIDIENNES=non

# Courriels d'alerte : reçus par le serveur de courrier de test de la pile, jamais envoyés dehors.
SMTP_HOTE=courrier-test
SMTP_PORT=1025
URL_APPLICATION=https://budget.hopitalia.cloud

# Ports publiés sur le serveur, en local seulement (Traefik passe par le réseau Docker). Changer
# s'ils sont déjà pris par une autre application.
ADRESSE_API=127.0.0.1:18000
ADRESSE_WEB=127.0.0.1:18080
