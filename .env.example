# Copier ce fichier en .env (non versionné) et renseigner les valeurs.

# Base de données locale (docker-compose.yml)
POSTGRES_USER=hopitalia
POSTGRES_PASSWORD=
POSTGRES_DB=hopitalia_budget

# Accès à Hopitalia (docs/cadrage/integration-hopitalia.md, section 3)
HOPITALIA_API_URL=
HOPITALIA_JWT_CLE=
HOPITALIA_COMPTE_TECHNIQUE=
HOPITALIA_COMPTE_TECHNIQUE_MOT_DE_PASSE=
# Code (dans le module) de l'établissement qui reçoit les services et la pharmacie d'Hopitalia.
HOPITALIA_ETABLISSEMENT=

# Clé de chiffrement des coordonnées bancaires des fournisseurs (Fernet).
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Une clé perdue rend les numéros de compte enregistrés illisibles : la sauvegarder hors du serveur.
COORDONNEES_CLE=

# Optionnel (valeurs par défaut dans backend/src/hopitalia_budget/config.py)
# LIMITE_REQUETES_PAR_MINUTE=300
# RETENTION_JOURS=30
# INTEGRATION_FENETRE_JOURS=30
# DUREE_CLE_IDEMPOTENCE_HEURES=24
# NIVEAU_JOURNAL=INFO
